{
  "name": "kyoli-gam-monorepo",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/*",
    "packages/providers/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:contract:native": "pnpm --filter opencode-multi-account-core test:contract:native && pnpm --filter opencode-codex-multi-account test:contract:native && pnpm --filter opencode-anthropic-multi-account test:contract:native",
    "serve": "pnpm --filter @kyoli-gam/cli serve",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "turbo": "^2.10.9",
    "vitest": "^4.1.10"
  }
}
